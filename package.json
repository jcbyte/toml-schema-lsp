{
	"name": "toml-schema-validator",
	"displayName": "TOML Schema Validator",
	"version": "0.1.0",
	"publisher": "jcbyte",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/jcbyte/toml-schema-lsp"
	},
	"engines": {
		"vscode": "^1.120.0"
	},
	"categories": [
		"Linters",
		"Programming Languages"
	],
	"activationEvents": [
		"onLanguage:toml"
	],
	"main": "./client/out/extension.js",
	"contributes": {
		"configuration": {
			"title": "TOML Schema",
			"properties": {
				"tomlSchema.remote.enabled": {
					"type": "boolean",
					"default": true,
					"scope": "machine",
					"description": "Allow fetching remote (https) TOML schemas."
				},
				"tomlSchema.remote.allowedHosts": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"scope": "machine",
					"markdownDescription": "Hosts remote TOML schemas may be fetched from, e.g. `example.com`. Schemas from any other host are not downloaded."
				}
			}
		}
	},
	"scripts": {
		"dev": "esbuild client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap",
		"build": "esbuild client/src/extension.ts --bundle --outfile=client/out/extension.js --external:vscode --format=cjs --platform=node --minify",
		"package": "npm run build && ts-node ./scripts/build-server.ts",
		"vscode:prepublish": "npm run package"
	},
	"dependencies": {
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@types/node": "^25.9.1",
		"@types/vscode": "^1.120.0",
		"esbuild": "^0.28.0",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	}
}
